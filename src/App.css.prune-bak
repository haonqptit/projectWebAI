}

.mini-info-card {
  left: 4.5%;
  bottom: 7%;
  width: 190px;
  padding: 14px 16px 16px;
  z-index: 18;
  border-radius: 8px;
}

.mini-info-card h2 {
  margin-bottom: 3px;
  font-size: clamp(15px, 1.12vw, 18px);
}

.mini-info-card p {
  margin-bottom: 9px;
  font-size: clamp(11px, 0.86vw, 14px);
  border-bottom-width: 1.5px;
}

.mini-info-card::after {
  width: 54px;
  height: 54px;
  top: -29px;
  right: -18px;
}

.scrapbook-status.in4-status-card {
  right: 4.5%;
  bottom: 7.5%;
  width: 220px;
  padding: 14px 16px 16px;
  z-index: 18;
  border-radius: 8px;
  box-shadow: 0 10px 20px rgba(61, 39, 30, 0.1);
}

.scrapbook-status.in4-status-card::before {
  top: -12px;
  right: 18px;
  width: 76px;
  height: 22px;
  background: url('/items/Dan.png') no-repeat center / contain;
  opacity: 0.85;
  transform: rotate(12deg);
  filter: drop-shadow(0 3px 5px rgba(61, 39, 30, 0.1));
}

.scrapbook-status h2 {
  margin-bottom: 8px;
  font-size: clamp(21px, 1.75vw, 30px);
}

.scrapbook-status ul {
  gap: 4px;
}

.scrapbook-status li {
  gap: 4px;
  font-size: clamp(10px, 0.86vw, 13px);
  line-height: 1.08;
}

.scrapbook-status li span {
  display: none;
}

.decor-sticker--headphone {
  display: block;
  top: 6%;
  left: 30%;
  width: 48px;
  opacity: 0.46;
  z-index: 13;
}

.decor-sticker--fish {
  display: block;
  top: 45%;
  left: 3%;
  width: 44px;
  opacity: 0.5;
  z-index: 13;
}

.decor-sticker--cat {
  display: block;
  right: 30%;
  bottom: 30%;
  width: 50px;
  opacity: 0.68;
  z-index: 16;
  transform: rotate(8deg);
}

.decor-sticker--camera,
.decor-sticker--flower {
  display: none;
}

