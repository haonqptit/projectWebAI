  font-size: 14px;
}

.linh-spread {
  width: min(95vw, 1360px);
  background:
    linear-gradient(90deg, rgba(255, 253, 248, 0.12), rgba(108, 75, 49, 0.04)),
    url('/crumpled_paper.png') no-repeat center center;
  background-size: cover;
  box-shadow: 0 24px 55px rgba(74, 44, 34, 0.18);
}

.paper-doll-spread .spread-left.paper-doll-left,
.paper-doll-spread .spread-right.cozy-desk-right {
  overflow: hidden;
}







.spread-seam {
  opacity: 0.62;
}

.paper-doll-spread .spread-right.cozy-desk-right::before {
  inset: 5% 3.5% 5% 4%;
  border-radius: 8px;
  background:
    linear-gradient(180deg, rgba(255, 253, 247, 0.36), rgba(255, 253, 247, 0.1)),
    repeating-linear-gradient(90deg, rgba(94, 62, 48, 0.025) 0 1px, transparent 1px 18px);
}

.cozy-desk-header {
  top: 6%;
}

.cozy-desk-title,
.cozy-desk-subtitle,
.desk-scene__placeholder-doodle,
.desk-scene__placeholder-text {
