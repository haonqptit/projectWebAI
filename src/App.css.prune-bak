/* ---- Final sticker-page balance: anhlinh is the main hero ---- */
.scrapbook-title {
  top: 4%;
  left: 50%;
  width: 66%;
  z-index: 32;
}

.scrapbook-title__hello {
  font-size: clamp(24px, 2.05vw, 34px);
}

.scrapbook-title__name {
  font-size: clamp(88px, 7.8vw, 128px);
}

.scrapbook-feature-zone {
  top: 18%;
  left: 18%;
  width: 245px;
  height: 390px;
  z-index: 25;
}

.scrapbook-feature-zone::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 48%;
  width: 225px;
  height: 260px;
  transform: translate(-50%, -50%) rotate(-8deg);
  border-radius: 48% 52% 46% 54%;
  background: radial-gradient(circle, rgba(224, 159, 176, 0.42), rgba(224, 159, 176, 0.12) 62%, transparent 78%);
  filter: blur(2px);
  z-index: 0;
  pointer-events: none;
}

.scrapbook-feature-cutout {
  top: 2%;
  left: 50%;
  height: clamp(300px, 27vw, 355px);
  z-index: 2;
  transform: translateX(-50%) rotate(-3deg);
  filter:
    drop-shadow(0 0 0 white)
    drop-shadow(0 0 8px white)
    drop-shadow(0 22px 28px rgba(61, 39, 30, 0.24));
  transition: transform 0.28s ease, filter 0.28s ease;
}

.scrapbook-feature-cutout:hover {
  transform: translateX(-50%) translateY(-8px) rotate(1deg) scale(1.03);
  filter:
    drop-shadow(0 0 0 white)
    drop-shadow(0 0 10px white)
    drop-shadow(0 28px 34px rgba(61, 39, 30, 0.28));
}

.scrapbook-feature-caption {
  bottom: 12px;
  z-index: 3;
  font-size: 15px;
  opacity: 0.9;
}

.scrapbook-hero {
  left: 41%;
  bottom: 8%;
  width: 175px;
  height: 235px;
  z-index: 18;
}

.scrapbook-hero__blob {
  bottom: 34px;
  width: 140px;
  height: 130px;
  opacity: 0.5;
}

.scrapbook-hero__img {
  left: 50%;
  bottom: 35px;
  height: clamp(180px, 16vw, 215px);
  transform: translateX(-50%) rotate(4deg);
  filter:
    drop-shadow(0 0 0 white)
    drop-shadow(0 0 5px white)
    drop-shadow(0 14px 18px rgba(61, 39, 30, 0.18));
}

.scrapbook-hero__img:hover {
  transform: translateX(-50%) translateY(-5px) rotate(2deg) scale(1.025);
}

.scrapbook-hero__caption {
  bottom: 2px;
  font-size: 13px;
  opacity: 0.88;
}

.scrapbook-cluster.in4-photo-cluster {
  top: 23%;
  right: 5.5%;
  left: auto;
  width: clamp(205px, 16.5vw, 235px);
  height: clamp(205px, 16.2vw, 235px);
  z-index: 16;
}

.scrapbook-cluster .in4-polaroid.polaroid {
  padding: 7px 7px 24px;
  box-shadow:
    0 10px 18px rgba(61, 39, 30, 0.12),
    0 2px 6px rgba(61, 39, 30, 0.07);
}

.mini-info-card {
  left: 4.5%;
  bottom: 7%;
  width: 185px;
  padding: 13px 15px 15px;
  z-index: 19;
}

.mini-info-card h2 {
  font-size: clamp(14px, 1.05vw, 18px);
}

.mini-info-card p {
  margin-bottom: 8px;
  font-size: clamp(10px, 0.82vw, 13px);
}

.scrapbook-status.in4-status-card {
  right: 4.5%;
  bottom: 7%;
  width: 215px;
  padding: 13px 15px 15px;
  z-index: 19;
}

.scrapbook-status h2 {
  margin-bottom: 7px;
  font-size: clamp(20px, 1.65vw, 28px);
}

.scrapbook-status li {
  font-size: clamp(10px, 0.82vw, 12px);
  line-height: 1.08;
}

.decor-sticker--headphone {
  display: block;
  top: 7%;
  left: 31%;
  width: 46px;
  z-index: 17;
  opacity: 0.58;
  transform: rotate(12deg);
}

.decor-sticker--camera {
  display: block;
  top: 22%;
  right: 5%;
  width: 48px;
  z-index: 17;
  opacity: 0.58;
  transform: rotate(13deg);
}

.decor-sticker--cat {
  display: block;
  left: 47%;
  bottom: 30%;
  width: 54px;
  z-index: 21;
  opacity: 0.74;
  transform: rotate(8deg);
}

.decor-sticker--fish {
  display: block;
  top: 52%;
  left: 4%;
  width: 48px;
  z-index: 17;
  opacity: 0.58;
}

.decor-sticker--flower {
  display: block;
  left: 19%;
  bottom: 23%;
  width: 48px;
  z-index: 17;
  opacity: 0.58;
  transform: rotate(-16deg);
}

