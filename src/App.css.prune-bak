@import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;600;700;800&family=Patrick+Hand&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Architects+Daughter&family=Satisfy&family=Gochi+Hand&display=swap');

body,
html {
  margin: 0;
  padding: 0;
  font-family: 'Courier New', Courier, monospace;
}

* {
  box-sizing: border-box;
}

.scrapbook-canvas {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background: url('/bg_map.jpg') no-repeat center center fixed;
  background-size: cover;
  overflow: hidden;
}

/* --- 2. THANH MENU + TIÃŠU Äá»€ SCRAPBOOK --- */
.navbar {
  position: absolute;
  top: 28px;
  left: 50px;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  transform: rotate(-3deg);
}

.nav-logo__sub {
  font-family: 'Caveat', cursive;
  font-size: 1.5rem;
  color: #4a2c22;
  background: rgba(255, 253, 247, 0.82);
  padding: 2px 12px;
  border-radius: 999px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
}

.nav-logo {
  font-family: 'Playfair Display', serif;
  font-size: 3rem;
  font-weight: bold;
  font-style: italic;
  color: #1a2a3a;
  background: rgba(255, 255, 255, 0.78);
  padding: 6px 22px;
  border-radius: 12px;
  box-shadow: 0 6px 18px rgba(74, 44, 34, 0.18);
  position: relative;
}

.nav-logo::before {
  content: '';
  position: absolute;
  top: -10px;
  left: 18px;
  width: 70px;
  height: 16px;
  background:
    repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.18) 0 6px, transparent 6px 12px),
    #e08244;
  opacity: 0.9;
  transform: rotate(-8deg);
  box-shadow: 0 3px 7px rgba(74, 44, 34, 0.18);
  border-radius: 2px;
}

.nav-logo__caption {
  font-family: 'Patrick Hand', cursive;
  font-size: 1.1rem;
  color: #3e2723;
  margin-top: 4px;
  padding-left: 8px;
}

/* --- 2b. POLAROID GIá»šI THIá»†U --- */
.intro-card {
  position: absolute;
  bottom: 60px;
  left: 60px;
  z-index: 60;
  width: 280px;
  background: #fffdf7;
  padding: 18px 22px 22px;
  border: 1px solid #e6d9c5;
  box-shadow: 0 14px 30px rgba(54, 36, 28, 0.28);
  transform: rotate(-4deg);
  font-family: 'Patrick Hand', cursive;
  color: #3e2723;
}

.intro-card__tape {
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%) rotate(-4deg);
  width: 110px;
  height: 22px;
  background:
    repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.18) 0 6px, transparent 6px 12px),
    rgba(224, 130, 68, 0.85);
  box-shadow: 0 3px 7px rgba(74, 44, 34, 0.18);
}

.intro-card__title {
  font-family: 'Caveat', cursive;
  font-size: 2rem;
  margin: 6px 0 8px;
  color: #4a2c22;
}

.intro-card__body {
  margin: 0 0 10px;
  font-size: 1.05rem;
  line-height: 1.4;
}

.intro-card__signature {
  margin: 0;
  text-align: right;
  font-family: 'Caveat', cursive;
  font-size: 1.2rem;
  color: #e08244;
}

/* --- 2c. áº¢NH CUTOUT NHÃ‚N Váº¬T --- */
.linh-cutout-hero {
  position: absolute;
  right: 2%;
  bottom: 0;
  height: 92vh;
  max-height: 1000px;
  width: auto;
  z-index: 40;
  pointer-events: none;
  user-select: none;
  filter: drop-shadow(-12px 14px 22px rgba(54, 36, 28, 0.32));
  animation: cutout-float 6s ease-in-out infinite;
}

@keyframes cutout-float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50%      { transform: translateY(-10px) rotate(-1deg); }
}

/* --- 2d. DECOR HOA LÃ / MÃY BAY --- */
.canvas-deco {
  position: absolute;
  pointer-events: none;
  background: no-repeat center / contain;
  z-index: 10;
  opacity: 0.85;
}

.canvas-deco--flower-tl {
  top: -30px;
  right: 22%;
  width: 160px;
  height: 160px;
  background-image: url('/items/bonghoa-removebg-preview.png');
  transform: rotate(-22deg);
  opacity: 0.7;
}

.canvas-deco--flower-br {
  bottom: -40px;
  left: 30%;
  width: 180px;
  height: 180px;
  background-image: url('/items/hoa2.png');
  transform: rotate(14deg);
  opacity: 0.65;
}

.canvas-deco--plane {
  top: 18%;
  left: 38%;
  width: 130px;
  height: 130px;
  background-image: url('/items/maybay-removebg-preview.png');
  transform: rotate(10deg);
  opacity: 0.85;
  filter: drop-shadow(0 6px 10px rgba(74, 44, 34, 0.2));
}

/* --- responsive nhá» gá»n --- */
@media (max-width: 900px) {
  .linh-cutout-hero { height: 60vh; right: -4%; }
  .intro-card { width: 220px; bottom: 30px; left: 20px; }
  .navbar { left: 20px; top: 16px; }
  .nav-logo { font-size: 2.2rem; }
  .canvas-deco--plane { display: none; }
}

/* --- 3. CÃƒÂC VÃƒâ€™NG TRÃƒâ€™N THÃƒâ‚¬NH VIÃƒÅ N --- */
.member-node {
  position: absolute;
  width: 90px;
  height: 90px;
  border-radius: 50%;
  border: 4px solid #ffffff;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  cursor: pointer;
  z-index: 50;
  transition: all 0.3s ease;
}

.member-node img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

.member-node:hover {
  transform: scale(1.15);
  border-color: #ff5252;
}

.country-tag {
  position: absolute;
  bottom: -25px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(26, 42, 58, 0.85);
  color: #ffffff;
  padding: 2px 10px;
  border-radius: 10px;
  font-size: 0.75rem;
  font-weight: bold;
  white-space: nowrap;
}

/* --- 4. TRANG CHI TIÃ¡ÂºÂ¾T MÃ¡ÂºÂ¶C Ã„ÂÃ¡Â»Å NH --- */
.member-focus-page {
  background: #f4eae1;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 50px;
}

.back-btn {
  position: absolute;
  top: 30px;
  left: 30px;
  z-index: 50;
  padding: 10px 20px;
  border: 2px dashed #3d2a1c;
  cursor: pointer;
  font-weight: bold;
  font-family: Inter, sans-serif;
  transition: 0.3s;
  background: rgba(255, 253, 247, 0.75);
  color: #3d2a1c;
}

.back-btn:hover {
  transform: rotate(-5deg);
  background: #fff;
}

.postcard-large {
  background: #fffdf7;
  padding: 50px;
  border: 1px solid #dcd2c3;
  box-shadow: 10px 10px 0 rgba(0, 0, 0, 0.05);
  max-width: 600px;
  text-align: center;
}

/* =========================================================
   5. TRANG LINH - DIGITAL SCRAPBOOK POSTER
   ========================================================= */
.linh-page {
  --paper-bg: #f5ebe0;
  --paper-card: #f3e9dc;
  --brown-main: #3e2723;
  --brown-soft: #5d4037;
  --dusty-pink: #c98290;
  --tape-orange: #e08244;

  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  gap: 24px;
  padding: 40px 0 80px;
  background:
    radial-gradient(circle at 20% 0%, rgba(224, 130, 68, 0.08), transparent 40%),
    radial-gradient(circle at 80% 100%, rgba(120, 80, 40, 0.08), transparent 45%),
    repeating-linear-gradient(115deg, rgba(184, 156, 110, 0.04) 0 2px, transparent 2px 9px),
    var(--paper-bg);
  font-family: 'Patrick Hand', 'Caveat', cursive;
  color: var(--brown-main);
  overflow-x: hidden;
}

.linh-page::before,
.linh-page::after {
  content: '';
  position: absolute;
  pointer-events: none;
  background: no-repeat center / contain;
  opacity: 0.18;
}

.linh-page::before {
  top: 60px;
  left: -40px;
  width: 180px;
  height: 180px;
  background-image: url('/items/bonghoa-removebg-preview.png');
  transform: rotate(-18deg);
}

.linh-page::after {
  bottom: 220px;
  right: -30px;
  width: 200px;
  height: 200px;
  background-image: url('/items/maybay-removebg-preview.png');
  transform: rotate(20deg);
}

.linh-back-btn {
  position: fixed;
  top: 24px;
  left: 24px;
  z-index: 100;
  border-radius: 999px;
  border: 2px dashed var(--brown-main);
  background: rgba(255, 253, 247, 0.9);
  color: var(--brown-main);
  box-shadow: 0 8px 24px rgba(74, 44, 34, 0.12);
  padding: 10px 20px;
  font-family: Inter, sans-serif;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.3s;
}

.linh-back-btn:hover {
  transform: rotate(-5deg) scale(1.05);
  background: #ffffff;
}

.linh-spread {
  position: relative;
  width: min(96vw, 1400px);
  aspect-ratio: 7 / 5;
  overflow: visible;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.18), rgba(74, 44, 34, 0.05)),
    url('/crumpled_paper.png') no-repeat center center;
  background-size: cover;
  box-shadow: 0 28px 70px rgba(74, 44, 34, 0.28);
  border-radius: 6px;
}

.linh-spread::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.18;
  background-image: repeating-linear-gradient(115deg, rgba(184, 156, 110, 0.05) 0 2px, transparent 2px 7px);
  z-index: 1;
  border-radius: inherit;
}

.spread-left {
  position: absolute;
  top: 0;
  left: 0;
  width: 58%;
  height: 100%;
  z-index: 2;
  isolation: isolate;
}

.spread-right {
  position: absolute;
  top: 0;
  right: 0;
  width: 42%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 5% 4% 4%;
  text-align: center;
  z-index: 2;
}

.spread-seam {
  position: absolute;
  top: 4%;
  bottom: 4%;
  left: 58%;
  width: 0;
  border-left: 1px dashed rgba(120, 80, 40, 0.28);
  z-index: 3;
  pointer-events: none;
}

.spread-seam__tape {
  position: absolute;
  left: -48px;
  width: 104px;
  height: 28px;
  background: url('/items/Dan.png') no-repeat center / contain;
  opacity: 0.9;
  filter: drop-shadow(0 4px 7px rgba(74, 44, 34, 0.16));
}
.spread-seam__tape--bot { bottom: 10%; transform: rotate(24deg); }


/* ---- Paperclips ---- */
/* ---- Polaroid frames ---- */
.polaroid {
  --photo-rotate: 0deg;
  --photo-scale: 1;
  --photo-lift: 0px;
  --tilt-x: 0deg;
  --tilt-y: 0deg;

  position: absolute;
  margin: 0;
  padding: 1.5% 1.5% 6%;
  background: #fffdf9;
  box-shadow:
    0 16px 32px rgba(70, 45, 30, 0.25),
    0 4px 10px rgba(70, 45, 30, 0.12);
  border: 1px solid rgba(214, 188, 148, 0.25);
  display: flex;
  flex-direction: column;
  cursor: pointer;
  transform-origin: center center;
  transform:
    perspective(900px)
    translateY(var(--photo-lift))
    rotateZ(var(--photo-rotate))
    rotateX(var(--tilt-x))
    rotateY(var(--tilt-y))
    scale(var(--photo-scale));
  transform-style: preserve-3d;
  transition: transform 0.16s ease, box-shadow 0.2s ease, filter 0.2s ease;
  will-change: transform;
}

.polaroid img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border: 1px solid rgba(0,0,0,0.05);
}

.polaroid:hover {
  --photo-scale: 1.045;
  --photo-lift: -8px;
  z-index: 20;
  box-shadow:
    0 28px 48px rgba(70, 45, 30, 0.32),
    0 6px 14px rgba(70, 45, 30, 0.16);
  filter: brightness(1.02);
}
@media (prefers-reduced-motion: reduce) {
  .polaroid {
    transition: box-shadow 0.2s ease, filter 0.2s ease;
    transform: rotateZ(var(--photo-rotate));
  }

  .polaroid:hover {
    --photo-scale: 1;
    --photo-lift: 0px;
  }

}

@media (max-width: 900px) {
  .linh-spread { aspect-ratio: auto; display: flex; flex-direction: column; }
}




.paper-doll-spread .spread-right.cozy-desk-right {
  position: absolute;
  top: 0;
  right: 0;
  width: 42%;
  height: 100%;
  display: block;
  padding: 0;
  text-align: left;
  isolation: isolate;
}

/* ---- LEFT: cutouts ---- */


/* ============================================================
   RIGHT: COZY DESK CORNER
   ============================================================ */

.cozy-desk-header {
  position: absolute;
  top: 5%;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  z-index: 10;
  width: 90%;
}
.cozy-desk-title {
  margin: 0;
  font-family: 'Caveat', 'Brush Script MT', cursive;
  font-size: clamp(34px, 3.4vw, 52px);
  color: #3b221c;
  line-height: 1.05;
}
.cozy-desk-subtitle {
  margin: 4px 0 0;
  color: #7a5a4b;
  font-size: 13px;
  font-style: italic;
}

.desk-scene {
  position: absolute;
  left: 50%;
  top: 22%;
  width: 82%;
  height: 46%;
  transform: translateX(-50%);
  border: 1.5px dashed rgba(107, 74, 66, 0.32);
  border-radius: 28px;
  background:
    radial-gradient(circle at 50% 48%, rgba(232, 186, 198, 0.28), transparent 58%),
    rgba(255, 250, 244, 0.32);
  box-shadow:
    0 1px 0 rgba(255, 255, 255, 0.9) inset,
    0 18px 35px rgba(61, 39, 30, 0.1);
  z-index: 4;
  overflow: hidden;
}
.desk-scene__image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.desk-scene__placeholder {
  position: absolute;
  inset: 18px;
  border-radius: 22px;
  display: grid;
  place-items: center;
  gap: 8px;
  color: rgba(107, 74, 66, 0.6);
  font-size: 14px;
  text-align: center;
  font-family: 'Caveat', 'Brush Script MT', cursive;
}
.desk-scene__placeholder-doodle {
  letter-spacing: 0.4em;
  color: #c69aa3;
  font-size: 18px;
}
.desk-scene__placeholder-text {
  font-size: 22px;
  line-height: 1.3;
  color: rgba(107, 74, 66, 0.7);
}

.desk-item-tray {
  position: absolute;
  left: 50%;
  bottom: 4%;
  width: 88%;
  height: 26%;
  transform: translateX(-50%);
  z-index: 12;
}

.desk-item {
  position: absolute;
  cursor: grab;
  user-select: none;
  touch-action: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 8px 10px 6px;
  background: rgba(255, 250, 244, 0.95);
  border-radius: 14px;
  border: 1px solid rgba(160, 120, 90, 0.18);
  box-shadow: 0 8px 16px rgba(74, 44, 34, 0.14);
  transition: filter 0.2s ease, scale 0.2s ease, box-shadow 0.2s ease;
  min-width: 64px;
}
.desk-item:hover {
  scale: 1.08;
  box-shadow: 0 12px 22px rgba(74, 44, 34, 0.2);
}
.desk-item.is-dragging {
  cursor: grabbing;
  z-index: 50;
  scale: 1.12;
  box-shadow: 0 18px 30px rgba(74, 44, 34, 0.26);
}
.desk-item__label {
  font-size: 11px;
  color: #6b4a42;
  letter-spacing: 0.04em;
  font-family: 'Caveat', 'Brush Script MT', cursive;
}

/* ---- Responsive ---- */

/* ============================================================
   CLEAN LINH REDESIGN OVERRIDES
   Reference: public/in4_linh.png used as visual direction only.
   ============================================================ */

.linh-page {
  --paper-bg: #f4eadc;
  --paper-card: rgba(255, 251, 244, 0.9);
  --brown-main: #3a241f;
  --brown-soft: #75584d;
  background:
    repeating-linear-gradient(115deg, rgba(112, 82, 56, 0.025) 0 1px, transparent 1px 9px),
    #f2e7d8;
}

.linh-page::before,
