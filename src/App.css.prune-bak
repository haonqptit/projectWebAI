}


/* ============================================================
   IN4 LINH LEFT PAGE â€“ SCRAPBOOK REDESIGN
   Prefix: .scrapbook-* for new elements
   ============================================================ */

/* ---- Page container ---- */
.paper-doll-spread .spread-left.in4-left-page.scrapbook-left-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 58%;
  height: 100%;
  z-index: 2;
  isolation: isolate;
  overflow: hidden;
}

.scrapbook-left-page::before {
  content: '';
  position: absolute;
  inset: 3% 3% 4%;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(circle at 30% 28%, rgba(255, 255, 255, 0.22), transparent 36%),
    radial-gradient(circle at 72% 75%, rgba(211, 154, 166, 0.08), transparent 40%);
  border-radius: 8px;
}

/* ---- A. TITLE ---- */
.scrapbook-title {
  position: absolute;
  top: 4%;
  left: 56%;
  transform: translateX(-50%);
  z-index: 24;
  text-align: center;
  color: #3b221c;
  pointer-events: none;
}

.scrapbook-title__hello {
  display: block;
  font-family: 'Caveat', 'Patrick Hand', cursive;
  font-size: clamp(24px, 2.2vw, 36px);
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.06em;
  color: rgba(59, 34, 28, 0.72);
}

.scrapbook-title__name {
  margin: 2px 0 0;
  font-family: 'Caveat', 'Patrick Hand', cursive;
  font-size: clamp(88px, 8vw, 132px);
  font-weight: 700;
  line-height: 0.88;
  color: #3b221c;
  text-shadow: 0 2px 0 rgba(255, 255, 255, 0.4);
  transform: rotate(-2deg);
}

/* ---- B. HERO CUTOUT ---- */
.scrapbook-hero {
  position: absolute;
  left: 28%;
  bottom: 4%;
  width: 250px;
  height: 340px;
  z-index: 14;
  margin: 0;
  pointer-events: auto;
}

.scrapbook-hero__blob {
  position: absolute;
  left: 50%;
  bottom: 40px;
  width: 200px;
  height: 200px;
  transform: translateX(-50%);
  border-radius: 999px;
  background: radial-gradient(circle, rgba(218, 157, 169, 0.42), rgba(218, 157, 169, 0.1) 62%, transparent 78%);
  filter: blur(2px);
  z-index: 0;
  pointer-events: none;
}

.scrapbook-hero__img {
  position: absolute;
  left: 80%;
  bottom: 133px;
  height: 285px;
  width: auto;
  transform: translateX(-50%) rotate(-3deg);
  transform-origin: center bottom;
  z-index: 2;
  filter:
    drop-shadow(0 0 0 white)
    drop-shadow(0 0 6px white)
    drop-shadow(0 20px 26px rgba(61, 39, 30, 0.24));
  transition: transform 0.35s ease, filter 0.35s ease;
  pointer-events: auto;
  user-select: none;
}

.scrapbook-hero__img:hover {
  transform: translateX(-50%) translateY(-8px) rotate(1deg) scale(1.03);
  filter:
    drop-shadow(0 0 0 white)
    drop-shadow(0 0 9px white)
    drop-shadow(0 28px 34px rgba(61, 39, 30, 0.32));
}

.scrapbook-hero__caption {
  position: absolute;
  bottom: 10px;
  left: 50%;
  transform: translateX(-50%) rotate(-2deg);
  z-index: 3;
  font-family: 'Caveat', cursive;
  font-size: 15px;
  color: #6b4a42;
  background: rgba(255, 250, 244, 0.82);
  padding: 3px 14px;
  border-radius: 999px;
  white-space: nowrap;
  box-shadow: 0 6px 14px rgba(74, 44, 34, 0.1);
}

/* ---- C. SECONDARY CUTOUT ---- */
.scrapbook-secondary {
  position: absolute;
  left: 5%;
  top: 6%;
  width: 140px;
  height: 200px;
  z-index: 15;
  margin: 0;
  pointer-events: auto;
}

.scrapbook-secondary__img {
  position: absolute;
  left: 50%;
  top: 4px;
  height: 168px;
  width: auto;
  transform: translateX(-50%) rotate(-5deg);
  z-index: 2;
  filter:
    drop-shadow(0 0 0 white)
    drop-shadow(0 0 4px white)
    drop-shadow(0 14px 18px rgba(61, 39, 30, 0.2));
  transition: transform 0.35s ease;
  user-select: none;
  pointer-events: auto;
}

.scrapbook-secondary__img:hover {
  transform: translateX(-50%) translateY(-4px) rotate(-2deg) scale(1.04);
}

.scrapbook-secondary__caption {
  position: absolute;
  bottom: 4px;
  left: 50%;
  transform: translateX(-50%) rotate(3deg);
  z-index: 3;
  font-family: 'Caveat', cursive;
  font-size: 13px;
  color: #6b4a42;
  background: rgba(255, 250, 244, 0.82);
  padding: 2px 10px;
  border-radius: 999px;
  white-space: nowrap;
  box-shadow: 0 5px 12px rgba(74, 44, 34, 0.09);
}

/* ---- D. MINI INFO CARD ---- */
.mini-info-card {
  position: absolute;
  left: 4%;
  bottom: 8%;
  width: clamp(200px, 17vw, 245px);
  z-index: 17;
  padding: 18px 20px 16px;
  color: #3b221c;
  background:
    radial-gradient(rgba(171, 130, 99, 0.1) 1px, transparent 1px) 0 0 / 6px 6px,
    rgba(248, 239, 225, 0.94);
  border: 1px solid rgba(150, 114, 78, 0.18);
  border-radius: 6px;
  box-shadow: 0 14px 26px rgba(61, 39, 30, 0.12);
  transform: rotate(-2deg);
  overflow: visible;
}

/* washi tape on top-left corner */
.mini-info-card::before {
  content: '';
  position: absolute;
  top: -12px;
  left: -16px;
  width: 96px;
  height: 26px;
  background: url('/items/Dan.png') no-repeat center / contain;
  z-index: 3;
  transform: rotate(-18deg);
  opacity: 0.88;
  filter: drop-shadow(0 3px 5px rgba(61, 39, 30, 0.1));
}

/* dried flower decoration on top-right corner */
.mini-info-card::after {
  content: '';
  position: absolute;
  top: -38px;
  right: -22px;
  width: 90px;
  height: 110px;
  background: url('/items/bonghoa-removebg-preview.png') no-repeat center / contain;
  z-index: 4;
  transform: rotate(18deg);
  opacity: 0.92;
  pointer-events: none;
  filter: drop-shadow(0 6px 10px rgba(61, 39, 30, 0.18));
}

.mini-info-card h2 {
  margin: 0 0 4px;
  font-family: 'Comic Sans MS', 'Patrick Hand', 'Caveat', cursive;
  font-size: clamp(16px, 1.35vw, 21px);
  font-weight: 900;
  font-style: italic;
  line-height: 1;
  letter-spacing: 0.02em;
  color: #3b221c;
}

.mini-info-card p {
  display: inline-block;
  margin: 0 0 12px;
  font-family: 'Comic Sans MS', 'Patrick Hand', 'Caveat', cursive;
  font-size: clamp(12px, 1vw, 16px);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: 0.03em;
  color: #4a2d25;
  text-transform: uppercase;
  border-bottom: 2px solid rgba(59, 34, 28, 0.7);
  padding-bottom: 1px;
}

.mini-info-card p:last-of-type {
  margin-bottom: 0;
}

/* ---- E. PHOTO CLUSTER (reposition for new layout) ---- */
.scrapbook-cluster.in4-photo-cluster {
  position: absolute;
  top: 22%;
  left: 50%;
  width: clamp(230px, 20vw, 290px);
  height: clamp(230px, 19vw, 280px);
  z-index: 16;
}

.scrapbook-cluster.in4-photo-cluster::before {
  content: '';
  position: absolute;
  top: 12px;
  left: 46px;
  width: 78px;
  height: 22px;
  background: url('/items/Dan.png') no-repeat center / contain;
  z-index: 8;
  opacity: 0.78;
  transform: rotate(-6deg);
  pointer-events: none;
}

.scrapbook-cluster .in4-polaroid.polaroid {
  position: absolute;
}

.scrapbook-cluster .in4-cluster-photo--bike {
  top: 0;
  left: 0;
  width: 56%;
  aspect-ratio: 1.08 / 1;
  z-index: 1;
  transform: rotate(-3deg);
}

.scrapbook-cluster .in4-cluster-photo--hanbok {
  top: 8%;
  left: 48%;
  width: 46%;
  aspect-ratio: 0.72 / 1;
  z-index: 2;
  transform: rotate(7deg);
}

.scrapbook-cluster .in4-cluster-photo--matcha {
  top: 44%;
  left: 14%;
  width: 64%;
  aspect-ratio: 1.08 / 1;
  z-index: 3;
  transform: rotate(-8deg);
}

.scrapbook-cluster .in4-cluster-photo--bike.in4-polaroid.polaroid:hover {
  transform: translateY(-5px) rotate(-2deg);
}

.scrapbook-cluster .in4-cluster-photo--hanbok.in4-polaroid.polaroid:hover {
  transform: translateY(-5px) rotate(5deg);
}

.scrapbook-cluster .in4-cluster-photo--matcha.in4-polaroid.polaroid:hover {
  transform: translateY(-5px) rotate(-6deg);
}

/* ---- F. STATUS CARD (compact) ---- */
.scrapbook-status.in4-status-card {
  position: absolute;
  right: 4%;
  bottom: 7%;
  width: clamp(220px, 17vw, 265px);
  z-index: 18;
  padding: 16px 18px 14px;
  color: #3b221c;
  background:
    radial-gradient(rgba(171, 130, 99, 0.1) 1px, transparent 1px) 0 0 / 6px 6px,
    rgba(248, 239, 225, 0.92);
  border: 1px solid rgba(150, 114, 78, 0.16);
  border-radius: 8px;
  box-shadow: 0 12px 24px rgba(61, 39, 30, 0.1);
  transform: rotate(1deg);
}

.scrapbook-status.in4-status-card::before {
  content: '';
  position: absolute;
  top: -75px;
  right: -70px;
  width: 188px;
  height: 180px;
  background: url('/items/Dan.png') no-repeat center / contain;
  z-index: 3;
  transform: rotate(0deg);
  opacity: 1;
  filter: drop-shadow(0 6px 10px rgba(61, 39, 30, 0.22));
  pointer-events: none;
}

.scrapbook-status h2 {
  margin: 0 0 10px;
  font-family: 'Comic Sans MS', 'Patrick Hand', 'Caveat', cursive;
  font-size: clamp(22px, 1.9vw, 34px);
  font-weight: 700;
  line-height: 0.95;
  color: #3b221c;
}

.scrapbook-status ul {
  display: grid;
  gap: 5px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.scrapbook-status li {
  display: flex;
  align-items: flex-start;
  gap: 5px;
  font-family: 'Comic Sans MS', 'Patrick Hand', 'Caveat', cursive;
  font-size: clamp(12px, 0.95vw, 17px);
  font-weight: 700;
  line-height: 1.2;
  color: #3b221c;
}

.scrapbook-status li span {
  flex: 0 0 1.3em;
  line-height: 1;
}

.scrapbook-status strong {
  margin-right: 3px;
  font-weight: 900;
}

/* ---- G. DECORATIVE STICKERS ---- */
.decor-sticker {
  position: absolute;
  pointer-events: none;
  user-select: none;
  z-index: 20;
  opacity: 0.88;
  filter: drop-shadow(0 8px 12px rgba(61, 39, 30, 0.14));
  transition: transform 0.4s ease;
}

.decor-sticker--fish {
  top: 48%;
  left: 2%;
  width: 80px;
  transform: rotate(-14deg);
}

.decor-sticker--headphone {
  top: 3%;
  left: 36%;
  width: 92px;
  transform: rotate(10deg);
  opacity: 0.72;
}

.decor-sticker--cat {
  right: 2%;
  bottom: 36%;
  width: 150px;
  transform: rotate(8deg);
  opacity: 0.76;
}

.decor-sticker--camera {
  top: 20%;
  right: 4%;
  width: 96px;
  transform: rotate(14deg);
  opacity: 0.68;
}

/* ---- H. STANDING CUTOUT (Linh3.png on right page) ---- */
.scrapbook-standing {
  position: absolute;
  right: -4%;
  bottom: 2%;
  height: 82%;
  width: auto;
  z-index: 6;
  pointer-events: none;
  user-select: none;
  transform: rotate(2deg);
  filter:
    drop-shadow(0 0 0 white)
    drop-shadow(0 0 6px white)
    drop-shadow(0 22px 28px rgba(61, 39, 30, 0.28));
}

.decor-sticker--flower {
  bottom: 3%;
  left: 42%;
  width: 50px;
  transform: rotate(-18deg);
  opacity: 0.55;
}

