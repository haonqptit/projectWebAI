/* ---- Feature cutout + public/design orbit items ---- */
.scrapbook-feature-zone {
  position: absolute;
  top: 18%;
  left: 5.5%;
  width: 32%;
  height: 46%;
  z-index: 16;
  pointer-events: none;
}

.scrapbook-feature-cutout {
  position: absolute;
  top: 7%;
  left: 50%;
  height: 82%;
  width: auto;
  transform: translateX(-50%) rotate(-2deg);
  z-index: 3;
  user-select: none;
  filter:
    drop-shadow(0 0 0 white)
    drop-shadow(0 0 5px white)
    drop-shadow(0 18px 22px rgba(61, 39, 30, 0.2));
}

.scrapbook-design-item {
  position: absolute;
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  padding: 7px;
  border-radius: 999px;
  background: rgba(255, 251, 244, 0.86);
  border: 1px solid rgba(135, 100, 74, 0.12);
  box-shadow: 0 9px 15px rgba(61, 39, 30, 0.12);
  z-index: 4;
}

.scrapbook-design-item img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  user-select: none;
}

.scrapbook-design-item--headphones {
  top: -2%;
  left: 58%;
  transform: rotate(10deg);
}

.scrapbook-design-item--glasses {
  top: 28%;
  left: -8%;
  transform: rotate(-13deg);
}

.scrapbook-design-item--phone {
  top: 52%;
  left: -4%;
  transform: rotate(9deg);
}

.scrapbook-design-item--pocket {
  top: 12%;
  right: -8%;
  transform: rotate(-7deg);
}

.scrapbook-design-item--lipstick {
  right: -2%;
  bottom: 23%;
  transform: rotate(14deg);
}

.scrapbook-design-item--bag {
  bottom: 2%;
  left: 47%;
  transform: rotate(-8deg);
}

@media (max-width: 900px) {
  .scrapbook-feature-zone {
    top: 210px;
    left: 7%;
    width: 260px;
    height: 370px;
  }

  .scrapbook-feature-cutout {
